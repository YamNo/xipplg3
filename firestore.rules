rules_version = '2';

// Rules Firestore untuk website kelas XI PPLG 3.
// Paste isi file ini ke Firebase Console -> Firestore Database -> tab Rules -> Publish.
//
// PENTING — keterbatasan yang disengaja:
// Login admin memakai email & password dari environment variable, yang ikut
// tertanam di bundle JavaScript sisi browser. Artinya Firestore TIDAK punya
// cara membuktikan bahwa yang mengirim permintaan benar-benar admin, sehingga
// rules di bawah tidak bisa membatasi hapus/ubah hanya untuk admin.
//
// Yang MASIH dilindungi rules ini (dibanding "allow read, write: if true"):
//  - Bentuk & isi data divalidasi: pesan chat maksimal 60 karakter, foto baru
//    wajib berstatus "pending", dan field yang tidak dikenal ditolak. Jadi
//    database tidak bisa dipakai menumpang menyimpan data sembarangan.
//  - Foto tidak bisa langsung tampil di galeri tanpa lewat proses persetujuan.
//  - Koleksi yang tidak terdaftar di sini sama sekali tidak bisa diakses.
//
// Yang TIDAK terlindungi: siapa pun yang tahu cara memakai API Firebase masih
// bisa menghapus atau mengubah data. Untuk menutup ini, login admin perlu
// dipindah ke Firebase Authentication.

service cloud.firestore {
  match /databases/{database}/documents {

    // Pesan Text Anonim.
    match /chats/{id} {
      allow read: if true;
      allow create: if request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 60
        && request.resource.data.keys().hasOnly(['message', 'sender', 'timestamp', 'userIp']);
      allow update, delete: if true;
    }

    // Foto galeri: unggahan baru WAJIB "pending" supaya tidak langsung tampil.
    match /images/{id} {
      allow read: if true;
      allow create: if request.resource.data.status == 'pending'
        && request.resource.data.url is string
        && request.resource.data.keys().hasOnly(['url', 'status', 'createdAt']);
      allow update, delete: if true;
    }

    match /assignments/{id}   { allow read, write: if true; }
    match /announcements/{id} { allow read, write: if true; }
    match /birthdays/{id}     { allow read, write: if true; }
    match /events/{id}        { allow read, write: if true; }
    match /blacklist_ips/{id} { allow read, write: if true; }
    match /schedule/{hari}    { allow read, write: if true; }
    match /settings/{doc}     { allow read, write: if true; }
    match /ratings/{id}       { allow read, write: if true; }

    // Koleksi lain: tidak boleh diakses sama sekali.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
