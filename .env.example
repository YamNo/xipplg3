# Salin file ini jadi .env lalu isi dengan config Firebase milikmu
# (Firebase Console -> Project Settings -> General -> Your apps -> SDK setup).
# File .env TIDAK ikut ke GitHub.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Password admin panel (/login/admin). Login cukup pakai password ini.
# PERINGATAN: nilai VITE_* ikut tertanam di bundle JavaScript yang dikirim ke
# browser, jadi ini BISA dibaca pengunjung lewat view-source.
VITE_ADMIN_PASSWORD=

# Bot Telegram untuk mengisi Tugas/Pengumuman/Acara/Ulang tahun dari chat.
# TANPA awalan VITE_ supaya tidak ikut ke bundle browser.
TELEGRAM_BOT_TOKEN=
TELEGRAM_SECRET=
TELEGRAM_ALLOWED_IDS=
TELEGRAM_WEBHOOK_URL=https://xipplg3.vercel.app/api/telegram

# Notifikasi push (muncul di HP walaupun website ditutup).
# Buat pasangan kunci dengan: npx web-push generate-vapid-keys
# Kunci publik boleh VITE_ (dipakai browser), kunci privat JANGAN.
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Rahasia untuk Vercel Cron (pengingat deadline harian jam 06.00 WIB).
CRON_SECRET=
