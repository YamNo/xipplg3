# Salin file ini jadi .env lalu isi dengan config Firebase milikmu
# (Firebase Console -> Project Settings -> General -> Your apps -> SDK setup).
# File .env TIDAK ikut ke GitHub.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Kredensial admin panel (/login/admin).
# PERINGATAN: nilai VITE_* ikut tertanam di bundle JavaScript yang dikirim ke
# browser, jadi ini BISA dibaca pengunjung lewat view-source.
VITE_ADMIN_EMAIL=
VITE_ADMIN_PASSWORD=
